[Unit]
Description=PolyMomentum Telegram operator monitor
After=network-online.target polymomentum-engine.service
Wants=network-online.target

[Service]
Type=simple
User=polymomentum
WorkingDirectory=/opt/polymomentum
EnvironmentFile=/etc/polymomentum/env
Environment=RUST_LOG=info
Environment=POLYMOMENTUM_DATA_DIR=/opt/polymomentum/data
Environment=POLYMOMENTUM_LOGS_DIR=/opt/polymomentum/logs
Environment=STATE_DB_PATH=/opt/polymomentum/logs/candle/state.db
Environment=SESSION_LOG_DIR=/opt/polymomentum/logs/sessions
Environment=KILL_SWITCH_PATH=/opt/polymomentum/KILL
ExecStart=/opt/polymomentum/polymomentum-engine telegram poll
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=64
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Hardening: read-only operator monitor, no control-plane writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/polymomentum

[Install]
WantedBy=multi-user.target
