[Unit]
Description=PolyMomentum band observer (signal_favorite_band_official_v1, paper: anchors + ladder, no orders)
After=network-online.target
Wants=network-online.target
# A persistent startup failure must become a clean stop, not an infinite
# 10-second restart loop (preflight failures exit 2, refuse-to-run
# conditions in pipeline init exit 3; both are excluded from restarts
# entirely). A breaker trip never exits: the engine parks in place
# (candle.halted heartbeat); the paper breaker re-arms on its own and the
# kill switch (KILL_OBSERVER) re-trips on the first cycle.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=polymomentum
WorkingDirectory=/opt/polymomentum
EnvironmentFile=/etc/polymomentum/env
EnvironmentFile=/etc/polymomentum/band-observer.env
# No secrets file: paper mode never builds the CLOB client or reads the
# wallet, and the observer must not carry the band wallet's key.
# The promotion artifact comes from POLYMOMENTUM_PROMOTION_ARTIFACT in
# band-observer.env - never a command-line pin (2026-09-01).
# The writable tree must exist before the sandbox below is set up: an
# The ReadWritePaths directory must exist BEFORE the unit starts: systemd
# builds the mount namespace ahead of ExecStartPre, so a missing path fails
# with 226/NAMESPACE. Install step:
#   sudo install -d -o polymomentum -g polymomentum -m 0755 /opt/polymomentum/logs/band-observer
# (the canary unit's /tmp lesson) and nothing else creates it (deploy.sh
# and setup.sh make logs/candle and logs/sessions only). `+` runs these as
# root outside the sandbox; the engine creates candle/ and sessions/
# underneath on its own.
ExecStart=/opt/polymomentum/tools/polymomentum-engine-band-v1 live --mode paper
# No ExecStop: systemd delivers KillSignal itself.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
# Only the observer's own tree is writable: it can never touch the
# canary's state, sessions or the control directory.
ReadWritePaths=/opt/polymomentum/logs/band-observer

[Install]
WantedBy=multi-user.target
