[Unit]
Description=PolyMomentum band canary (signal_favorite_band_official_v1, live)
After=network-online.target
Wants=network-online.target
# A persistent startup failure must become a clean stop, not an infinite
# 10-second restart loop (preflight failures exit 2 and are excluded from
# restarts entirely).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=polymomentum
WorkingDirectory=/opt/polymomentum
EnvironmentFile=/etc/polymomentum/env
EnvironmentFile=/etc/polymomentum/band-canary.env
# Server-only secrets (band wallet PRIVATE_KEY + derived POLY_API_*).
# Loaded LAST so they always win; this file is never synced from the
# repo, so config redeploys can no longer clobber credentials.
EnvironmentFile=-/etc/polymomentum/band-canary-secrets.env
# Credentials live in their own file so config redeploys of
# band-canary.env can never clobber them (incident 2026-08-25 10:10).
EnvironmentFile=/etc/polymomentum/band-canary-secrets.env
ExecStart=/opt/polymomentum/tools/polymomentum-engine-band-v1 live --mode live --i-understand-live --promotion-artifact /opt/polymomentum/promotions/band_promotion_compound.json
ExecStop=/bin/kill -SIGTERM $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
# NB: /tmp paths in ReadWritePaths are a reboot bomb (/tmp is wiped on boot
# and namespace setup fails with 226/NAMESPACE when the path is absent).
ReadWritePaths=/opt/polymomentum

[Install]
WantedBy=multi-user.target
