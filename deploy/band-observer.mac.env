# Mac stopgap for the band observer while the VPS is unreachable
# (docs/profitability_basement_2026-09-18.md section F item 8). Paper
# mode, public websockets only (Binance ticker, Polymarket market feed),
# no CLOB client, no wallet, no secrets. Run from the repo root:
#   cd /Users/ttoomm/Documents/PolyMomentum && cargo build --manifest-path rust_engine/Cargo.toml
#   set -a; . deploy/band-observer.mac.env; set +a
#   rust_engine/target/debug/polymomentum-engine live --mode paper
# `host: mac` rows are discovery data only until the Mac/VPS overlap check
# passes (section C, data plane).
#
# The engine loads ./.env for any variable still unset, and the repo-root
# .env carries wallet and API keys: pin them empty here so the observer
# process never sees them (an empty value is "set" to the loader).
PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
CHAINLINK_DATA_STREAMS_API_KEY=
CHAINLINK_DATA_STREAMS_HMAC_SECRET=
CHAINLINK_DATA_STREAMS_REST_WEBSOCKET_USERNAME=
VENUE=paper_only
POLYMOMENTUM_REQUIRE_PROMOTION=true
# The only checked-in artifact of the margin50 family (the VPS's
# band_promotion_margin50.json is not in git; cap 0.91 here vs 0.92 there).
POLYMOMENTUM_PROMOTION_ARTIFACT=deploy/promotions/band_promotion_margin50_cap91.json
BANKROLL_USD=19.00
CANDLE_POSITION_PCT=0.25
MAX_POSITION_PER_MARKET_USD=25.0
MAX_TOTAL_EXPOSURE_USD=19.0
# Inert for the band path (the loop ticks on Binance freshness); kept for
# parity with deploy/band-observer.env.
CANDLE_SETTLEMENT_ALIGNMENT_READY=1
CANDLE_WINDOW_MINUTES=5
KILL_SWITCH_PATH=logs/band-observer/KILL_OBSERVER
RISK_BOOK=v1
BAND_ANCHOR_SECONDS=150,180,195,210,225,240
BAND_LADDER_BUDGETS_USD=5,25,100
POLYMOMENTUM_HOST_LABEL=mac
# Own tree under the (git-ignored) logs/ directory. The Mac's disk sits
# below the default 15% free-space watermark (38 GiB of 460 GiB on
# 2026-09-18); the ladder writes ~6.5 MB/day at six anchors (~4.3 at the
# four before 2026-09-23), so a 5 GiB / 1% floor is the Mac-sized gate.
# The VPS observer keeps the defaults.
POLYMOMENTUM_PREFLIGHT_MIN_FREE_DISK_GB=5
POLYMOMENTUM_PREFLIGHT_MIN_FREE_DISK_PCT=1
POLYMOMENTUM_DATA_DIR=logs/band-observer/data
POLYMOMENTUM_LOGS_DIR=logs/band-observer
STATE_DB_PATH=logs/band-observer/candle/state.db
SESSION_LOG_DIR=logs/band-observer/sessions
CANDLE_LIVE_MAX_CUMULATIVE_LOSS_PCT=0.6
CANDLE_BREAKER_MAX_CONSECUTIVE_LOSSES=1000000
