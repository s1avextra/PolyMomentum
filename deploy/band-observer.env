# Band observer overrides (loaded after /etc/polymomentum/env by
# polymomentum-band-observer.service). The observer is the canary's
# configuration run as `live --mode paper`: no CLOB client, no orders, no
# wallet reads, no secrets file; it exists to write the money-free records
# (band_anchor, band_ladder) while the canary is halted. Same artifact path
# and hash as deploy/band-canary.env so the observer reads the windows the
# canary would trade; the two never run on the wallet at the same time
# (docs/profitability_basement_2026-09-18.md section C).
# /etc/polymomentum/env (loaded first by the unit, and the target of the
# /opt/polymomentum/.env symlink the engine reads for anything still
# unset) carries the legacy engine's wallet and API keys. Pinned empty
# here so the observer process never sees a key: systemd applies this
# file last, and the engine's .env loader never overrides a variable that
# is already set. Paper mode builds no CLOB client regardless; the pins
# also stop the 5-minute wallet balance read (monitoring_loop), which keys
# off PRIVATE_KEY.
PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
VENUE=polymarket_international
OPERATOR_COUNTRY=IE
POLYMOMENTUM_VENUE_COMPLIANCE_OK=1
POLYMOMENTUM_REQUIRE_PROMOTION=true
# band_v2 (operator-approved 2026-09-01): compound sizing + \$50 decision-
# margin floor. Hash 81f93e1b... (identical to the canary's pin).
POLYMOMENTUM_PROMOTION_ARTIFACT=/opt/polymomentum/promotions/band_promotion_margin50.json
POLYMOMENTUM_LIVE_RECONCILIATION_READY=1
CLOB_V2_READY=1
# Paper sizing base: the canary's pinned allocation, so the anchor quote
# budgets and the paper stakes match what the canary would size.
BANKROLL_USD=19.00
CANDLE_POSITION_PCT=0.25
MAX_POSITION_PER_MARKET_USD=25.0
MAX_TOTAL_EXPOSURE_USD=19.0
# Attested on the canary (deploy/band-canary.env); inert for the band
# path: in band mode the cycle loop ticks on Binance freshness and the
# signal side is the Binance tick at-or-before the decision instant vs the
# tick at-or-before the open (band_basis_prices). Kept so the release
# manifest's config hash matches the canary's.
CANDLE_SETTLEMENT_ALIGNMENT_READY=1
CANDLE_WINDOW_MINUTES=5
# The observer's own kill switch: KILL_BAND stops the canary, never this.
KILL_SWITCH_PATH=/opt/polymomentum/control/KILL_OBSERVER
BAND_SIZING=kelly_lo
RISK_BOOK=v1
# Money-free records. Anchors: the four decision seconds the evaluator
# grids (150/180/210/240); at each, band_anchor plus a band_ladder record
# (the momentum-side book sampled once per second for 30 s at these
# budgets: worst = the FOK limit, vwap, shares, depth_limited). Empty
# disables either. host labels the rows for the Mac/VPS overlap check.
BAND_ANCHOR_SECONDS=150,180,210,240
BAND_LADDER_BUDGETS_USD=5,25,100
POLYMOMENTUM_HOST_LABEL=vps
# Own log, state and session tree; never the canary's.
POLYMOMENTUM_LOGS_DIR=/opt/polymomentum/logs/band-observer
STATE_DB_PATH=/opt/polymomentum/logs/band-observer/candle/state.db
SESSION_LOG_DIR=/opt/polymomentum/logs/band-observer/sessions
# Paper losses must never park the observer (the paper breaker re-arms on
# its own; this keeps the streak brake from tripping in between).
CANDLE_LIVE_MAX_CUMULATIVE_LOSS_PCT=0.6
CANDLE_BREAKER_MAX_CONSECUTIVE_LOSSES=1000000
