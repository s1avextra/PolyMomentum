# Band canary overrides (loaded after /etc/polymomentum/env).
# Operator attestations reuse the git-tracked live-readiness record
# (docs/live_readiness_2026-05-23.md): IE operator, international venue,
# V2 signing verified. Live go decision: operator, 2026-08-24
# ("go canary on current wallet balance").
VENUE=polymarket_international
OPERATOR_COUNTRY=IE
POLYMOMENTUM_VENUE_COMPLIANCE_OK=1
POLYMOMENTUM_REQUIRE_PROMOTION=true
# Compounding scale (operator 2026-08-25: "continue on current balance and
# scale on the accumulation"): stake = 25% of effective bankroll
# (allocation + realized PnL), floored at the $5 venue minimum, capped at
# $25 until the next review. Artifact hash c95fc6ab...
POLYMOMENTUM_PROMOTION_ARTIFACT=/opt/polymomentum/promotions/band_promotion_compound.json
POLYMOMENTUM_LIVE_RECONCILIATION_READY=1
CLOB_V2_READY=1
# Fixed allocation: $20 starting capital on the dedicated band wallet;
# effective bankroll compounds with realized PnL (the persisted baseline
# never overrides an explicit BANKROLL_USD).
BANKROLL_USD=20.00
# Mirrors the compounding artifact's position_pct for the preflight
# budget check (actual sizing: clamp(equity*0.25, $5, $25)).
CANDLE_POSITION_PCT=0.25
MAX_POSITION_PER_MARKET_USD=25.0
MAX_TOTAL_EXPOSURE_USD=50.0
LIVE_ALLOW_MAKER_ORDERS=0
# Attested: oracle alignment was validated empirically (official Gamma
# resolutions vs the Chainlink trailing-60s stream, 100% parity at
# decisive margins; docs/twap_resolution_rule_change_2026-08-17.md).
# With this on, the band signal side is the sign of the venue's own RTDS
# Chainlink price move - the resolving quantity itself (Binance-sign
# agreement measured 77/77). Feed staleness >10s fails safe: no price,
# no trades. The legacy candle path is unreachable under the band
# promotion artifact regardless.
CANDLE_SETTLEMENT_ALIGNMENT_READY=1
CANDLE_WINDOW_MINUTES=5
KILL_SWITCH_PATH=/opt/polymomentum/control/KILL_BAND
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Deposit wallet (POLY_1271): the venue blocks fresh EOA makers, so the
# maker/signer is the deposit wallet derived from our EOA and registered
# on Polymarket 2026-08-26 (deployed, all four trading approvals set).
# Collateral, balance guards and the wallet timeline all follow it.
POLY_FUNDER=0x1a581Bf1995AB04Cc116E4FFDb3B385F8a1D4bDf
POLYMOMENTUM_LOGS_DIR=/opt/polymomentum/logs/band-canary
# Explicit, so an inherited STATE_DB_PATH/SESSION_LOG_DIR from the base env
# can never silently point the canary at the legacy engine's state.
STATE_DB_PATH=/opt/polymomentum/logs/band-canary/candle/state.db
SESSION_LOG_DIR=/opt/polymomentum/logs/band-canary/sessions
# Accumulation-mode brakes (percentages are of the FIXED $20 base, so
# these are absolute dollars): hard restart-proof halt at -$60 cumulative,
# session halt at -$60, and 5 consecutive losses. Individual losses no
# longer halt (a compounder must survive them); the wallet itself bounds
# the worst case until equity exceeds the caps.
CANDLE_LIVE_MAX_CUMULATIVE_LOSS_PCT=3.0
CANDLE_BREAKER_MAX_SESSION_LOSS_PCT=3.0
CANDLE_BREAKER_MAX_CONSECUTIVE_LOSSES=5
