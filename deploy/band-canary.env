# Band canary overrides (loaded after /etc/polymomentum/env).
# Operator attestations reuse the git-tracked live-readiness record
# (docs/live_readiness_2026-05-23.md): IE operator, international venue,
# V2 signing verified. Live go decision: operator, 2026-08-24
# ("go canary on current wallet balance").
VENUE=polymarket_international
OPERATOR_COUNTRY=IE
POLYMOMENTUM_VENUE_COMPLIANCE_OK=1
POLYMOMENTUM_REQUIRE_PROMOTION=true
POLYMOMENTUM_PROMOTION_ARTIFACT=/opt/polymomentum/promotions/band_promotion_v1.json
POLYMOMENTUM_LIVE_RECONCILIATION_READY=1
CLOB_V2_READY=1
# Bankroll 0 = auto-detect from the wallet pUSD balance (canary runs on
# the current wallet, per operator instruction).
BANKROLL_USD=0
MAX_POSITION_PER_MARKET_USD=5.0
MAX_TOTAL_EXPOSURE_USD=5.0
LIVE_ALLOW_MAKER_ORDERS=0
# Band signal basis is the exchange mid (Binance basis per the
# preregistration); outcomes settle on official resolutions. The band
# branch does not consult this attestation; keep it off so the legacy
# candle path could never trade under this unit either.
CANDLE_SETTLEMENT_ALIGNMENT_READY=0
CANDLE_WINDOW_MINUTES=5
KILL_SWITCH_PATH=/opt/polymomentum/control/KILL_BAND
POLYMOMENTUM_LOGS_DIR=/opt/polymomentum/logs/band-canary
