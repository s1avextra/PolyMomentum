# ── Polymarket API credentials (live mode only) ──────────────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_BASE_URL=https://clob.polymarket.com
POLY_GAMMA_URL=https://gamma-api.polymarket.com

# ── Chainlink Data Streams shadow settlement feed ────────────────
# Used for official BTC candle settlement evidence, not as a live entry signal
# until latency/alignment reports are archived.
# Paste the three values from the Chainlink Data Streams REST/WebSocket
# credentials screen. FEED_IDS are separate 0x... stream IDs from the stream
# list/subscription page, not credential-card values.
CHAINLINK_DATA_STREAMS_REST_URL=https://api.dataengine.chain.link
CHAINLINK_DATA_STREAMS_REST_WEBSOCKET_USERNAME=
CHAINLINK_DATA_STREAMS_API_KEY=
CHAINLINK_DATA_STREAMS_HMAC_SECRET=
CHAINLINK_DATA_STREAMS_FEED_IDS=

# ── Wallet (private key required only for live mode + balance auto-detect) ──
PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com

# ── Live venue safety gates (fail closed) ────────────────────────
VENUE=paper_only
OPERATOR_COUNTRY=
POLYMOMENTUM_VENUE_COMPLIANCE_OK=0
POLYMARKET_US_API_ENABLED=0
CLOB_V2_READY=0
POLYMOMENTUM_LIVE_RECONCILIATION_READY=0
CANDLE_SETTLEMENT_ALIGNMENT_READY=false
POLYMOMENTUM_PROMOTION_ARTIFACT=
POLYMOMENTUM_REQUIRE_PROMOTION=0
# Paper-only escape hatch for legacy artifacts that predate the current
# inventory/accounting model. Never enable for live.
POLYMOMENTUM_ALLOW_STALE_RESEARCH_ARTIFACT=0
LIVE_MIN_ORDER_SIZE_SHARES=5.0
LIVE_ORDER_BUDGET_BUFFER=1.10

# ── Capital & risk ────────────────────────────────────────────────
# Paper/shadow/backtest use a fresh $100 simulated bankroll by default.
# Live with BANKROLL_USD=0 may auto-detect wallet pUSD after live preflight.
BANKROLL_USD=100
CANDLE_SIMULATED_BALANCE_RESET_ON_START=1
MAX_TOTAL_EXPOSURE_USD=80.0
MAX_POSITION_PER_MARKET_USD=20.0

# ── Candle strategy ───────────────────────────────────────────────
CANDLE_WINDOW_MINUTES=5
CANDLE_POSITION_PCT=0.10
CANDLE_MAX_PRICE=0.90
CANDLE_NOISE_Z_THRESHOLD=0.3

# ── Circuit breaker ───────────────────────────────────────────────
# The band runtime halts on the consecutive-loss streak and the
# cross-restart cumulative live loss cap (survives bankroll actualization);
# the breaker holds across restarts until the operator re-arms it.
CANDLE_BREAKER_MAX_CONSECUTIVE_LOSSES=8
CANDLE_LIVE_MAX_CUMULATIVE_LOSS_PCT=0.50
CANDLE_PAPER_BREAKER_RESET_ON_START=0
CANDLE_PAPER_BREAKER_AUTO_REARM_SECS=300

# ── Operator alerting (Slack/webhook or Telegram required in live mode) ─
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated numeric chat ids allowed to use Telegram callbacks.
TELEGRAM_ALLOWED_CHAT_IDS=
ALERT_REQUIRED=0

# ── Operational kill switch ──────────────────────────────────────
KILL_SWITCH_PATH=/opt/polymomentum/KILL

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info

# ── Persistence paths (override if you want non-default locations) ──
POLYMOMENTUM_DATA_DIR=/opt/polymomentum/data
POLYMOMENTUM_LOGS_DIR=/opt/polymomentum/logs
STATE_DB_PATH=/opt/polymomentum/logs/candle/state.db
SESSION_LOG_DIR=/opt/polymomentum/logs/sessions
POLYMOMENTUM_PREFLIGHT_MIN_FREE_DISK_GB=10
POLYMOMENTUM_PREFLIGHT_MIN_FREE_DISK_PCT=15
